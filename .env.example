# Leave empty to use Vite proxy → http://localhost:8080/api
VITE_API_BASE_URL=

# Google Identity Services Web client ID (must also be in relay-server GOOGLE_OAUTH_CLIENT_IDS)
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key comes from the API with each Checkout session.
# Configure STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET on relay-server.
